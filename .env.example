# Copy to `.env` and fill in a key. `.env` is gitignored and never committed.
# Everything below is OPTIONAL -- the project runs fully without any of it,
# using a deterministic scripted provider.

# Which provider serves free-text turns: scripted | groq | gemini
# The named scenarios always use the scripted provider so they stay deterministic.
PROVIDER=groq

# Free keys:
#   Groq    https://console.groq.com/keys
#   Gemini  https://aistudio.google.com/apikey
GROQ_API_KEY=
# GEMINI_API_KEY=

# Override the model id if the default has been retired. Model ids change often;
# list what your key can reach with:
#   curl -H "authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
#   groq   default: openai/gpt-oss-20b
#   gemini default: gemini-2.0-flash
# MODEL=openai/gpt-oss-20b

# PORT=8787
# TIMEOUT_MS=30000
# RUNTIME_DATA_DIR=.runtime-data
